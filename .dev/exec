#!/usr/bin/env bash
# Runs a command in the dev environment of this repository. With no command, opens a shell in it.
# One entry point at a fixed path, for a person, an agent, and a git hook.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ "$#" -eq 0 ]; then
  set -- "${SHELL:-bash}"
fi
if [ "${DEV_ENV_ROOT:-}" = "$root" ]; then
  exec "$@"
fi
export DEV_ENV_ROOT="$root"
exec nix develop "$root" --command "$@"
